# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection used by Prisma at runtime.
# Matches the credentials in docker-compose.yml by default (local dev).
#
# In production with Supabase, use the *transaction pooler* connection string
# (port 6543) and append ?pgbouncer=true, e.g.:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.fakikkixijuoczgisots:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.fakikkixijuoczgisots:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Secret used to sign/derive session-related values. Generate a random one:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Initial admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Administrator"

# ---------------------------------------------------------------------------
# Email (optional). Choose ONE provider. If none is configured, verification /
# password-reset links are printed to the server console, so the template works
# out of the box with no mail server. Test your setup with:
#   npm run email:test -- you@example.com
#
# The "from" address for all outgoing mail. For Resend/SMTP this domain (or
# sender) usually has to be verified with your provider.
MAIL_FROM="No Reply <no-reply@example.com>"

# Option A — Resend (simplest: just an API key). Sign up at resend.com, verify a
# sending domain, create an API key. For quick tests you can use the shared
# sender by setting MAIL_FROM="Acme <onboarding@resend.dev>".
RESEND_API_KEY=""

# Option B — SMTP (Office 365, Gmail, Postmark, SendGrid, ...). Only used when
# RESEND_API_KEY is empty. SMTP_SECURE=true for port 465, false for 587/25.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
