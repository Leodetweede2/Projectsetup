# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Matches the credentials in docker-compose.yml by default.
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"

# Base URL of the app, used to build links in verification / reset emails.
APP_URL="http://localhost:3000"

# Secret used to sign/derive session-related values. Generate a random one:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Initial admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Administrator"

# ---------------------------------------------------------------------------
# SMTP (optional). If these are left blank, verification / password-reset
# links are printed to the server console instead of being emailed, so the
# template works out of the box with no mail server.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="No Reply <no-reply@example.com>"
