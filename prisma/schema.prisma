// Prisma schema for the reusable app template.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" covers local development; "debian-openssl-3.0.x" matches the
  // node:20-bookworm-slim image used for the Fly.io production container.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime queries. In production this is the Supabase transaction pooler
  // (port 6543, with ?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Used by `prisma migrate` / `prisma db push`. In production this is the
  // Supabase direct/session connection (port 5432). Locally it can equal
  // DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles     Role[]     @relation("UserRoles")
  sessions  Session[]
  auditLogs AuditLog[] @relation("AuditActor")

  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  // Permission keys granted by this role (see src/lib/rbac/permissions.ts).
  permissions String[]
  // System roles cannot be deleted from the admin UI.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[] @relation("UserRoles")
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 hash of the opaque session token stored in the cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id         String                @id @default(cuid())
  // Email address the token was issued for.
  identifier String
  // SHA-256 hash of the raw token sent to the user.
  tokenHash  String                @unique
  type       VerificationTokenType
  expiresAt  DateTime
  createdAt  DateTime              @default(now())

  @@index([identifier])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Floor-plan PC locator
// ---------------------------------------------------------------------------

model FloorPlan {
  id          String   @id @default(cuid())
  name        String
  building    String?
  floor       String?
  // Storage object key (see src/lib/storage.ts).
  imageKey    String
  // Pixel size of the rendered image, so pin fractions map back to pixels.
  imageWidth  Int
  imageHeight Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@index([building, floor])
}

model Room {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  number      String
  name        String?
  department  String?
  // Pin position as a fraction (0..1) of the image width/height.
  x           Float
  y           Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  devices Device[]

  @@index([floorPlanId])
  @@index([number])
}

model Device {
  id        String   @id @default(cuid())
  // Hostname or label of the PC/device.
  name      String
  assetTag  String?
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([roomId])
}

// ---------------------------------------------------------------------------
// Imported asset list (from an Excel/SharePoint export)
// ---------------------------------------------------------------------------

model AssetImport {
  id               String        @id @default(cuid())
  filename         String
  // Which column holds the room number used to link a row to a floor-plan pin.
  roomNumberColumn String
  // Ordered list of column headers (for rendering the overview table).
  columns          String[]
  rowCount         Int
  createdAt        DateTime      @default(now())
  createdById      String?
  records          AssetRecord[]
}

model AssetRecord {
  id         String      @id @default(cuid())
  importId   String
  import     AssetImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  // Normalised room number (for matching Room.number).
  roomNumber String
  // All columns of the row as { header: value }.
  data       Json
  // Lower-cased concatenation of all values, for simple full-row search.
  searchText String
  createdAt  DateTime    @default(now())

  @@index([importId])
  @@index([roomNumber])
}
